# 复制为 .env 后按实际环境修改（不配置时使用 app/config.py 中的默认值）

# MySQL 连接
MYSQL_HOST=192.168.1.4
MYSQL_PORT=3306
MYSQL_USER=mowen
MYSQL_PASSWORD=Mowen@1998
MYSQL_DATABASE=photo_album

# JWT 密钥（生产环境务必修改为随机长字符串）
SECRET_KEY=photo-album-secret-key-please-change-in-production
TOKEN_EXPIRE_MINUTES=1440

# 初始管理员账号（仅首次启动创建时生效）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_DEMO_USERNAME=demo
INIT_DEMO_PASSWORD=123456

# 上传大小上限（MB）：首次启动的初始值，之后管理员可在前端「用户权限」弹窗中调整
MAX_UPLOAD_SIZE_MB=5

# ================= 以下仅 Docker 部署（docker compose）使用 =================

# MySQL 容器 root 密码（健康检查 / 管理维护用）
MYSQL_ROOT_PASSWORD=root123456

# 应用对外暴露端口（默认 8000，宿主机端口冲突时修改）
APP_PORT=8000

# 注意：Docker 部署时 MYSQL_HOST 会被 compose 固定为容器服务名 mysql，
# 上方 MYSQL_HOST/MYSQL_PORT 仅在非容器（本机/裸机）部署时生效。
