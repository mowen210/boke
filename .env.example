# 复制为 .env 后按实际环境修改（不配置时使用 app/config.py 中的默认值）

# MySQL 连接
MYSQL_HOST=192.168.1.4
MYSQL_PORT=3306
MYSQL_USER=mowen
MYSQL_PASSWORD=Mowen@1998
